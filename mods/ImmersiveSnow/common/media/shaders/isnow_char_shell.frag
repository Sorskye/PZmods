#version 110
// generated by tools/gen_char_snow.py from isnow_charsnow.frag, do not edit
#define SHELL

// Immersive Snow: a snow coating on characters and on items in hand, the look of the vehicle snow
// (isnow_vehiclesnow.frag): ragged fields of settled snow on what faces up, stuck-on snow on the
// rest, and on zombies' clothes icing (glaze): clear ice where snow melted and froze again, around
// the stuck-on snow and over the lower legs, blue and glossy with the cloth showing through it and
// white rime crystals along its edge (items are players' only and get none). Only a coating on the
// surface, no snow volume; the snow gets its relief from shading (bright upper rim, blue-grey lower
// one, as lit from the top of the screen).
//
// A template: tools/gen_char_snow.py writes the shaders from it, one of
//   SHELL  isnow_char_shell: only the snow, the rest discarded, on a copy of a worn clothing item's
//          mesh (a body visual with the same mesh, clothingItems/ISnow_CS_*.xml, see
//          ISnow_CharSnowDebug.lua); a small depth bias puts it over the item it copies. The amount
//          comes per character from the body visual's tint (TintColour): r = amount 0..1,
//          g below 0.5 = debug view, from ICED_G with icing (zombies; players get none: they
//          would not walk around glazed in ice), b = scale of the snow fields on top (bags less).
//   ITEM   isnow_item_<id>: the model itself (an item in hand whose model is swapped for a copy
//          with this shader): basicEffect.frag's texture and lighting, the snow blended over it;
//          P_AMOUNT = snow amount 0..0.98, 1.0 = debug view (camera-frame normal as colour)
// Where the snow lies comes from vertUpFacing, how much the surface faces up now (camera-frame
// normal vertViewNormal, world up UP_VIEW: CharacterModelCamera uses Core.DoPushIsoStuff like the
// vehicles). Shells get none below the waist (vertRestHeight, the rest-pose height): swinging legs
// would show snow coming and going; and no frost speckles on the sides (they read as paint
// splatter on cloth). The noise uses the rest-pose position (shells) or the mesh UVs (items), so
// the patches stick to the cloth or the item. Offline look check: tools/charsnow_render/render.py,
// GPU cost against another version of this file: tools/charsnow_render/bench.py.

#if !defined(SHELL) && !defined(ITEM)
// the template itself (never used by a model)
#define SHELL
#endif

varying vec3 vertColour;
varying vec3 vertNormal;
varying vec3 vertViewNormal;
varying float vertUpFacing;
varying float vertRestUp;
varying float vertRestHeight;
varying vec3 vertRestPos;
varying vec2 texCoords;

uniform sampler2D Texture;
uniform float Alpha;

uniform vec3 TintColour;

uniform vec3 AmbientColour;
uniform vec3 Light0Direction;
uniform vec3 Light0Colour;
uniform vec3 Light1Direction;
uniform vec3 Light1Colour;
uniform vec3 Light2Direction;
uniform vec3 Light2Colour;
uniform vec3 Light3Direction;
uniform vec3 Light3Colour;
uniform vec3 Light4Direction;
uniform vec3 Light4Colour;

const float BIAS_SCALE = 0.0004;
#ifdef SHELL
// over the clothing item the shell copies (same mesh, barely inflated)
const float BIAS = 0.53;
#else
const float BIAS = 0.5;
#endif
// the ground's snow (SNOW_REF in tools/gen_prints.py): brighter, it glowed next to the ground in
// shade and fog
const vec3 SNOW_COLOUR = vec3(0.886, 0.906, 0.933);
const vec3 FROST_COLOUR = vec3(0.83, 0.86, 0.905);
// shaded side of the snow (its lower rim and thin edges), as SNOW_SHADE of the vehicles
const vec3 SNOW_SHADE = vec3(0.70, 0.76, 0.86);
// Icing: ice with air in it, what is under it showing through tinted ICE_TINT (shells: the cloth
// texture's brightness only, its tint is not known here) behind a milky blue haze (ICE_MILK of
// ICE_TINT); glossy and uneven: brighter towards the silhouette (ICE_FRESNEL, the snow around
// reflected) and glints where it mirrors the sky (ICE_GLINT, sharpness ICE_GLINT_POW); thicker
// inside, so its surface tilts by up to ICE_BUMP towards the edge; white rime along the edge
// (RIME_WIDTH, units of the noise it is cut from)
const vec3 ICE_TINT = vec3(0.72, 0.84, 0.97);
const float ICE_MILK = 0.6;
const float ICE_BUMP = 0.8;
const float ICE_FRESNEL = 0.45;
const float ICE_GLINT = 0.6;
const float ICE_GLINT_POW = 8.0;
const float RIME_WIDTH = 0.05;
// Shading of the snow: how much brighter its upper rim and darker its lower one (RELIEF), the core
// thickness (noise units past the edge) where it is full white
const float RELIEF = 0.12;
const float CORE = 0.1;
// Opacity of the settled snow and of the frost patches (a thin coating lets the cloth show through)
const float SNOW_OPACITY = 0.92;
const float FROST_OPACITY = 0.6;
// Items: how much of the sides the frost patches cover at full snow, 0..1
const float SIDE_FROST = 0.7;
// Rest-pose height of the waist (mesh units, the body is ~0.98 tall): no snow fields below it on
// clothes (the legs get only the coating)
const float LEG_TOP = 0.55;
// Shells: all their noise is 3D noise of the rest-pose position (vertRestPos, mesh units, the body
// ~0.98 tall), continuous across UV seams (UV noise broke into lines along them) and fixed to the
// cloth. The snow is opaque: characters are drawn into a texture with alpha and then over the world,
// so a translucent coating lowered that alpha and the world showed through the character.
//   fields:  settled snow on what faces up now, above the waist
//   patches: stuck snow on all the cloth but underneath (rest pose), more on the lower legs, as from
//            walking through snow; at full snow about a quarter of the cloth, half of the shins
const float FIELD_FREQ = 30.0;
const float PATCH_FREQ = 18.0;
const float PATCH_BASE = 0.8;
const float PATCH_GAIN = 0.17;
const float LOW_GAIN = 0.16;
const float SHIN_TOP = 0.3;
// Shells: icing from GLAZE_FROM of the amount around the stuck-on snow, cut from its noise (no
// noise of its own): a thin glazed rim (GLAZE_REACH noise units past the snow at full snow), on the
// shins a crust reaching GLAZE_LOW further, where snow from walking melted and froze
const float GLAZE_REACH = 0.035;
const float GLAZE_FROM = 0.25;
const float GLAZE_LOW = 0.12;
// Shells: tint g from which the icing shows (zombies 1, players below it, the debug view below 0.5)
const float ICED_G = 0.875;
// Shells: darker snow (ISnow.darkSnow) comes in tint g too: players 0.625 instead of 0.75 (below
// DARK_PLAYER_G), zombies 0.9375 instead of 1 (from ICED_G below DARK_ZOMBIE_G); items get SNOW_DARK.
// Thresholds halfway, safe in the 8-bit tint of the visual sync.
const float DARK_PLAYER_G = 0.6875;
const float DARK_ZOMBIE_G = 0.96875;
// the darker snow's colour over ours (ISnow.DARK_SNOW_RGB)
const vec3 DARK_RGB = vec3(0.729, 0.765, 0.795);
// Shells: players get PLAYER_MORE times the snow fields and stuck-on snow of zombies at the same
// amount (they have no icing, and their snow had to read at the game's zoom; 1.5 was too much)
const float PLAYER_MORE = 1.2;
// Shells: players show PLAYER_LOOK of the look; with PLAYER_MORE alone a full layer still left
// what faces up all white (95% of it; 81% with this, the sides 30% -> 18%)
const float PLAYER_LOOK = 0.8;
// Snow fields on top: noise frequency (UV), threshold and how much the amount adds
const float COVER_FREQ = 22.0;
const float COVER_BASE = 0.74;
const float COVER_GAIN = 0.36;
const float FROST_FREQ = 45.0;
// Grain of the ragged edges; characters are small on screen, finer grain gives single pixels
const float GRAIN_FREQ = 160.0;
// The look rises faster than the snow level: amount = 1 - (1 - level)^LOOK_POW, so a third of a
// layer already reads as snow at the game's zoom (linear, it was a few specks up to half a layer)
const float LOOK_POW = 3.0;
const vec3 UP_VIEW = vec3(0.0, 0.8660254, -0.5);
// towards the camera in the camera frame (a top face, UP_VIEW, faces it by 0.5)
const vec3 TO_EYE = vec3(0.0, 0.0, -1.0);

float hash(vec2 p)
{
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float valueNoise(vec2 p)
{
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	float a = hash(i);
	float b = hash(i + vec2(1.0, 0.0));
	float c = hash(i + vec2(0.0, 1.0));
	float d = hash(i + vec2(1.0, 1.0));
	return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

float hash3(vec3 p)
{
	return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453);
}

float valueNoise3(vec3 p)
{
	vec3 i = floor(p);
	vec3 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	float a = mix(mix(hash3(i), hash3(i + vec3(1.0, 0.0, 0.0)), f.x),
		mix(hash3(i + vec3(0.0, 1.0, 0.0)), hash3(i + vec3(1.0, 1.0, 0.0)), f.x), f.y);
	float b = mix(mix(hash3(i + vec3(0.0, 0.0, 1.0)), hash3(i + vec3(1.0, 0.0, 1.0)), f.x),
		mix(hash3(i + vec3(0.0, 1.0, 1.0)), hash3(i + vec3(1.0, 1.0, 1.0)), f.x), f.y);
	return mix(a, b, f.z);
}

// The 3-octave fbm valueNoise3(p) * 0.5 + valueNoise3(p * 2.03) * 0.3 + valueNoise3(p * 4.01) * 0.2
// where it reaches t, and below t (not the fbm) where it cannot: every octave is in [0, 1) times
// its weight, so after the first the rest adds under 0.5 and after the second under 0.2. Most
// fragments far below t are decided without the finer octaves.
float fbm3Cut(vec3 p, float t)
{
	float v = valueNoise3(p) * 0.5;
	if (v + 0.5 < t) return v;
	v += valueNoise3(p * 2.03) * 0.3;
	if (v + 0.2 < t) return v;
	return v + valueNoise3(p * 4.01) * 0.2;
}

float fbm(vec2 p)
{
	return valueNoise(p) * 0.5 + valueNoise(p * 2.03) * 0.25 + valueNoise(p * 4.01) * 0.125
		+ valueNoise(p * 8.07) * 0.125;
}

// Solid where d >= 0.04, grainy along a ragged fringe below that (width w)
bool raggedFill(float d, float w, float grain)
{
	return d >= 0.04 || (d >= 0.04 - w && grain <= (d - 0.04 + w) / w);
}

// Which way noise d rises on the screen (x right, y up), about unit length: only the direction of
// its screen-space gradient counts, so it does not change with the zoom. -y is which rim of a patch
// cut from d a fragment is on: 1 on the upper rim (d falls towards the top of the screen), -1 on the
// lower one. Call it where the neighbouring fragments work out d as well (not in a branch that only
// some of them take): the gradient comes from them.
vec2 riseDir(float d)
{
	vec2 g = vec2(dFdx(d), dFdy(d));
	return g / (abs(g.x) + abs(g.y) + 1e-5);
}

// Shading of a snow patch from its noise distance d past the edge (0 at the edge) and its upper
// rim (-riseDir(d).y): thin snow at the edge in the blue-grey shade, the upper rim bright and the
// lower one shaded, as if the snow had thickness.
vec3 snowShade(vec3 colour, float d, float rim)
{
	float thick = smoothstep(0.0, CORE, d);
	float shade = 1.0 + RELIEF * rim * (1.0 - thick);
	vec3 c = mix(SNOW_SHADE, colour, 0.55 + 0.45 * thick);
	// the upper rim no brighter than the snow: it outshone the ground's snow
	return min(c * shade, colour);
}

// Ice over what is under it (under: its colour unlit; vn: camera-frame normal; rise: riseDir of
// the noise it is cut from, towards its thicker inside), rime crystals along the edge (edge 1 at the
// ice's edge, 0 inside; crystal: grain 0..1)
vec3 iceColour(vec3 under, vec3 vn, vec2 rise, float edge, float crystal)
{
	vec3 c = mix(under, ICE_TINT, ICE_MILK) * ICE_TINT;
	// gloss: the snow around mirrored towards the silhouette, the sky in glints; the surface tilts
	// away from the thick inside (the camera frame's x, y are the screen's)
	vn = normalize(vn - vec3(rise * ICE_BUMP, 0.0));
	float fresnel = 1.0 - abs(dot(vn, TO_EYE));
	c += ICE_FRESNEL * fresnel * fresnel * fresnel;
	c += ICE_GLINT * pow(max(dot(reflect(-TO_EYE, vn), UP_VIEW), 0.0), ICE_GLINT_POW);
	return mix(min(c, vec3(1.0)), FROST_COLOUR, edge * smoothstep(0.3, 0.7, crystal));
}

vec3 lightAt(vec3 normal)
{
	vec3 lighting = AmbientColour;
	lighting += Light0Colour * max(dot(normal, normalize(Light0Direction)), 0.0);
	lighting += Light1Colour * max(dot(normal, normalize(Light1Direction)), 0.0);
	lighting += Light2Colour * max(dot(normal, normalize(Light2Direction)), 0.0);
	lighting += Light3Colour * max(dot(normal, normalize(Light3Direction)), 0.0);
	lighting += Light4Colour * max(dot(normal, normalize(Light4Direction)), 0.0);
	return min(lighting, vec3(1.0));
}

void main()
{
	vec3 normal = normalize(vertNormal);
	vec3 vn = normalize(vertViewNormal);
	vec4 texSample = texture2D(Texture, texCoords);
#ifdef ITEM
	if (texSample.w < 0.01) discard;
#else
	// the shell has the clothing item's texture: no snow where the cloth is not (painted clothes are
	// the whole body mesh with a texture that is transparent off the cloth)
	if (texSample.w < 0.5) discard;
#endif

#ifdef SHELL
	bool debugView = TintColour.g < 0.5;
	float amount = clamp(TintColour.r, 0.0, 1.0);
	vec3 tint = vec3(1.0);
	bool dark = TintColour.g < DARK_PLAYER_G || (TintColour.g >= ICED_G && TintColour.g < DARK_ZOMBIE_G);
#else
	bool debugView = P_AMOUNT > 0.99;
	float amount = clamp(P_AMOUNT / 0.98, 0.0, 1.0);
	float grey = dot(TintColour, vec3(0.299, 0.587, 0.114));
	vec3 tint = mix(TintColour, vec3(grey), 0.3);
#ifdef SNOW_DARK
	bool dark = true;
#else
	bool dark = false;
#endif
#endif
	amount = 1.0 - pow(1.0 - amount, LOOK_POW);
#ifdef SHELL
	if (TintColour.g < ICED_G) amount *= PLAYER_LOOK;
#endif
	if (debugView)
	{
		gl_FragColor = vec4((vn * 0.5 + 0.5) * Alpha, Alpha);
		gl_FragDepth = gl_FragCoord.z - (BIAS - 0.5) * 2.0 * BIAS_SCALE;
		return;
	}

	float facing = clamp(vertUpFacing, -1.0, 1.0);
	// the steeper, the more snow it takes to settle
	float minFacing = mix(0.9, 0.35, amount);
	vec3 snow = vec3(0.0);
	float cover = 0.0;
#ifdef SHELL
	vec3 rp = vertRestPos;
	float height = vertRestHeight;
	float side = smoothstep(-0.6, 0.3, clamp(vertRestUp, -1.0, 1.0));
	// settled snow on what faces up now, only above the waist: legs swing, and snow that follows the
	// facing would come and go with every step
	float up = height >= LEG_TOP ? smoothstep(minFacing - 0.25, 1.0, facing) : 0.0;
	// TintColour.b scales the fields per item (bags get fewer)
	float more = TintColour.g >= ICED_G ? 1.0 : PLAYER_MORE;
	float fieldAt = COVER_BASE - amount * COVER_GAIN * more * up * TintColour.b;
	float fd = -1.0;
	float fieldRim = 0.0;
	if (up > 0.0)
	{
		// all of what faces up works it out, so the field's rim has its neighbours (riseDir)
		fd = fbm3Cut(rp * FIELD_FREQ, fieldAt) - fieldAt;
		fieldRim = -riseDir(fd).y;
	}
	bool field = fd >= 0.0;
	if (field)
	{
		snow = snowShade(SNOW_COLOUR, fd, fieldRim) * (0.95 + 0.05 * valueNoise3(rp * 60.0));
	}
	else
	{
		// stuck-on snow on all the cloth but underneath, more on the lower legs, as from walking
		// through snow; icing around it from GLAZE_FROM of the amount, a crust on the shins (under
		// a field it is not seen, so not worked out). Players (tint g under ICED_G) get no icing:
		// plain snow reaches as far instead, or they looked far less snowy than the zombies
		float low = smoothstep(SHIN_TOP, 0.05, height) * amount;
		float patchAt = PATCH_BASE - (PATCH_GAIN * amount * mix(0.5, 1.0, TintColour.b) + LOW_GAIN * low) * more * side;
		float shin = smoothstep(0.0, 0.5, low / max(amount, 0.01));
		float glaze = smoothstep(GLAZE_FROM, 1.0, amount) * (GLAZE_REACH + GLAZE_LOW * shin) * side;
		float rim = 0.0;
		if (TintColour.g >= ICED_G) rim = glaze; else patchAt -= glaze;
		float d = fbm3Cut(rp * PATCH_FREQ + 3.1, patchAt - rim) - patchAt;
		vec2 rise = riseDir(d);
		float edge = d + rim;
		if (edge < 0.0) discard;
		if (d >= 0.0)
		{
			snow = snowShade(FROST_COLOUR, d, -rise.y) * (0.95 + 0.05 * valueNoise3(rp * 60.0));
		}
		else
		{
			// the cloth texture's brightness through the ice (its tint is not known to the shell)
			float lum = dot(texSample.rgb, vec3(0.299, 0.587, 0.114));
			snow = iceColour(vec3(lum), vn, rise, 1.0 - smoothstep(0.0, RIME_WIDTH, edge), valueNoise3(rp * 140.0));
		}
	}
	cover = 1.0;
#else
	float noise = valueNoise(texCoords * 40.0) * 0.65 + valueNoise(texCoords * 90.0) * 0.35;
	float grain = valueNoise(texCoords * GRAIN_FREQ);

	// ragged fields of settled snow on what faces up
	float up = smoothstep(minFacing - 0.25, 1.0, facing);
	float dc = fbm(texCoords * COVER_FREQ + vec2(5.3, 1.7)) + amount * COVER_GAIN * up + (noise - 0.5) * 0.08
		- COVER_BASE;
	// elsewhere frost patches, more towards the top, none underneath (worked out everywhere, as
	// the field, for riseDir)
	float frost = amount * amount * SIDE_FROST * smoothstep(-0.4, minFacing, facing);
	float pd = fbm(texCoords * FROST_FREQ) + frost * 0.18 - 0.75;
	// no icing: items are only in players' hands and on their bodies (as their clothes, see ICED_G)
	float fieldRim = -riseDir(dc).y;
	float patchRim = -riseDir(pd).y;
	if (up > 0.0 && raggedFill(dc, 0.08, grain))
	{
		snow = snowShade(SNOW_COLOUR, dc - 0.04, fieldRim) * (0.94 + 0.06 * noise);
		cover = SNOW_OPACITY;
	}
	else if (facing >= -0.5 && raggedFill(pd, 0.1, grain))
	{
		snow = snowShade(FROST_COLOUR, pd, patchRim) * (0.9 + 0.1 * grain);
		cover = FROST_OPACITY;
	}
#endif

	vec3 lighting = lightAt(normal);
	// the snow is lit as the ground: the engine lights characters up to ~1.3x their square's light
	// (AmbientColour is 0.45 of it, two sky fills of 0.425 without falloff, lamps once more), which
	// white snow showed as a glow in shade and at night
	vec3 snowLight = min(lighting, AmbientColour / 0.45);
	if (dark) snow *= DARK_RGB;
#ifdef ITEM
	vec3 base = texSample.xyz * TintColour * lighting * vertColour;
	gl_FragColor = vec4(Alpha * mix(base, snow * snowLight * tint, cover), Alpha * texSample.w);
#else
	// opaque (see above): Alpha only fades the whole character as the vanilla shader does
	gl_FragColor = vec4(snow * snowLight * tint * Alpha, Alpha);
#endif
	gl_FragDepth = gl_FragCoord.z - (BIAS - 0.5) * 2.0 * BIAS_SCALE;
}
