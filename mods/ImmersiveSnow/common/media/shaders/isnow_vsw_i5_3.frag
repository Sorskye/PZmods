#version 110
// generated by tools/gen_vehicle_snow.py from isnow_vehiclesnow.frag, do not edit
#define WHEEL
#define ICE_LAYER
#define P_AMOUNT 0.800000
#define P_BIAS 0.530000
#define P_AXIS -1.000000
#define P_SEED 0.750000

// Immersive Snow: snow on vehicles. Drawn over a copy of a vehicle mesh (a "shell", see
// ISnow_VehicleShells.lua): the body, a separate body piece (door, hood...) or a wheel. Ragged
// fields of snow with thickness on the surfaces that face up, frost and icing in zones on the rest.
//
// A mod cannot set its own uniforms on a vehicle sub-model, so this file is a template:
// tools/gen_vehicle_snow.py writes one shader per variant with the parameters as constants
//   P_AMOUNT  snow amount 0..0.98; 1.0 = debug view (normal as colour, glass / rim red, nothing
//             discarded)
//   P_BIAS    depth bias, 0.5 = none; above pulls the snow towards the camera
//   P_AXIS    up axis in the normal's space for debug views: 0 = +Y, 0.25 = +Z, 0.5 = -Z,
//             0.75 = -Y, 1 = +X; below 0 world up from the camera (UP_VIEW), used for the snow
// , the layer it draws (both for the debug variants)
//   SNOW_LAYER    the settled snow: ragged fields on what faces up; wind and engine heat take it
//   ICE_LAYER     the icing: frost patches and hoarfrost zones on the body (also under the fields,
//                 which are drawn over it with a larger bias), frost on glass and along its edges,
//                 the patches on tyres and rims; stays while driving, only thaw takes it
//   GLASS_LAYER   hoarfrost on the glass alone (the frost of a vehicle parked in the cold,
//                 VehicleFrost): from the edges and in feathery ferns at the first stages, the
//                 glass frosted over at the last; nothing on the body (body shells only)
// and, optionally (body shells)
//   CLEAN_GLASS   nothing on the glass: the icing of a vehicle whose windows were scraped or
//                 brushed clean (the rest of the body keeps its icing)
// , optionally SNOW_DARK (darker snow: Snow Lands - Darker Snow or the DarkSnow option, isnow_vsbd_ /
// isnow_vswd_, see ISnow.darkSnow), and one of
//   VEHICLE_MASK  body and body pieces (isnow_vsb_<id>). Using TextureRust makes the engine treat
//                 it as a vehicle shader (Shader.isVehicleShader: its uniform location is not -1, so
//                 the compiler must not drop it, see keepVehicleShader), and Model.DrawVehicle then
//                 binds the parent vehicle's textures for a sub-model: Texture0 (its paint, with
//                 TexturePainColor), TextureMask (glass gets snow only along its edge), but not the
//                 model's own Texture. The shell draws over the same mesh with the same UVs.
//                 With NO_MASK too (isnow_vsbm_<id>): for vehicles whose script names no mask
//                 (vanilla burnt wrecks). DrawVehicle binds nothing for a null texture
//                 (ShaderProgram.setValue returns, 42.21), so TextureMask would read whatever another
//                 draw left on its unit, and glass and uninstalled zones flickered over the wreck
//                 as that changed; then nothing is glass or uninstalled. (Rust has the same gap, but
//                 BaseVehicle sets TextureRustA 0 on a vehicle without wheels, as wrecks are.)
//   WHEEL         wheels (isnow_vsw_<id>_<seed>), P_SEED shifts the noise per wheel. Not a vehicle
//                 shader, so Texture is the wheel's own: its dark parts are the tyre, the rest
//                 (rim, hub) gets only a few patches.
// Snow and frost are drawn with their opacity as the alpha: ModelSlotRenderData.renderVehicle draws
// a vehicle with blending on (SRC_ALPHA, ONE_MINUS_SRC_ALPHA), its body first and our shells after
// the models they lie on (they are made visible later, and BaseVehicle.setModelVisible appends), so
// thin frost lets the vehicle as drawn show through: dents, scratches, blood, rust, lights, from
// whatever shader the vehicle uses. The shells used to redo the body's colour under the frost
// themselves (paint, reflection, rust), and a damaged vehicle looked repaired under it (Workshop
// comment, 2026-10-08): vanilla adds damage and blood in several ways (vehicle, vehicle_multiuv,
// vehicle_norandom_multiuv, KI5's damn_vehicle_shader...), most from a second UV set.
// Static models get transform = identity (the model matrix is in ModelViewProjection), so the
// normal is in mesh space, and meshes differ in which axis is up (-Z for most bodies, +Y for the
// vanilla "WithDoors" ones; wheels spin). The vertex shaders also pass the normal in the camera's
// rotation frame (vertViewNormal), where world up is the constant UP_VIEW whatever the mesh.
// On bodies the noise uses the mesh UVs, so its scale follows the texture atlas, not the vehicle's
// size. Wheels take it from the mesh-space position in world units (vertMeshPos, it turns with the
// wheel): wheel UV layouts differ a lot (the vanilla wheel's side is 0.28 of a 128 px texture, a
// KI5 one 0.8 of 256 px), and UV noise made the vanilla patches and rim band three times coarser.

#ifndef P_AMOUNT
// the template itself (never used by a model): a mid stage of the body shader
#define VEHICLE_MASK
#define P_AMOUNT 0.6
#define P_BIAS 0.55
#define P_AXIS -1.0
#endif
#if !defined(SNOW_LAYER) && !defined(ICE_LAYER) && !defined(GLASS_LAYER)
#define SNOW_LAYER
#define ICE_LAYER
#endif
#ifndef P_SEED
#define P_SEED 0.0
#endif

varying vec3 vertColour;
varying vec3 vertNormal;
varying vec3 vertViewNormal;
varying vec2 texCoords;
varying vec3 vertMeshPos;
// height in world units above the model's origin (vertex shaders)
varying float vertHeight;

uniform sampler2D Texture;
#ifdef VEHICLE_MASK
uniform sampler2D Texture0;
uniform vec4 TexturePainColor;
uniform sampler2D TextureMask;
uniform sampler2D TextureRust;
uniform float TextureRustA;
// mask zones of parts the vehicle has not got: windows broken, removed or open, doors removed
// (BaseVehicle.checkDamage / checkUninstall2 on the body's model instance, passed to sub-models too)
uniform mat4 TextureUninstall1;
uniform mat4 TextureUninstall2;
#endif

uniform vec3 TintColour;

uniform vec3 AmbientColour;
uniform vec3 Light0Direction;
uniform vec3 Light0Colour;
uniform vec3 Light1Direction;
uniform vec3 Light1Colour;
uniform vec3 Light2Direction;
uniform vec3 Light2Colour;
uniform vec3 Light3Direction;
uniform vec3 Light3Colour;
uniform vec3 Light4Direction;
uniform vec3 Light4Colour;

uniform float Alpha;

const float BIAS_SCALE = 0.0004;
// Slope part of the bias (as glPolygonOffset's factor): the depth change across one pixel, times
// this, is added to BIAS_SCALE, capped at SLOPE_CAP of it. The shell is the body's mesh drawn again,
// so its depth is the body's; where a surface turns edge-on to the camera (the sides as the body
// rolls in a turn) a pixel spans a lot of depth and the rounding of the two draws differs by more
// than the constant part.
const float SLOPE_BIAS = 1.0;
const float SLOPE_CAP = 2.0;
// the ground's snow (SNOW_REF in tools/gen_prints.py): brighter, it glowed next to the ground in
// shade and fog
const vec3 SNOW_COLOUR = vec3(0.886, 0.906, 0.933);
const vec3 FROST_COLOUR = vec3(0.83, 0.86, 0.905);
// the darker snow's colour over ours (ISnow.DARK_SNOW_RGB)
const vec3 DARK_RGB = vec3(0.729, 0.765, 0.795);
// How much of the light's colour snow drops (vanilla vehicles drop 0.3)
const float SNOW_DESATURATE = 0.6;
// How much of the sides the icing covers at full snow, 0..1
const float SIDE_FROST = 0.8;
// Snow fields on top: noise frequency (UV), threshold and how much the amount adds, tuned offline
// with a numpy port of this shader: a flat top is about 12% covered at stage 1, 80% at stage 6.
const float COVER_FREQ = 14.0;
const float COVER_BASE = 0.74;
const float COVER_GAIN = 0.36;
// Glass (mask window zones) gets snow only along its edge: a drift on the frame, thick against it and
// thinning out onto the glass, up to GLASS_EDGE UV units wide at full snow (ragged by noise at
// GLASS_EDGE_FREQ, UV), GLASS_SILL times wider along the bottom edge of tilted glass (snow slides
// down onto the frame below; none on glass facing up more than GLASS_FLAT).
const float GLASS_EDGE = 0.014;
// The drift and the hoarfrost rim are for glass at least GLASS_SPAN_FULL UV high (frame to frame,
// down the glass): vanilla windows are 0.055 and more. Smaller glass gets them narrower in
// proportion (not under GLASS_SPAN_MIN times): the B42 W900 has windows 0.02 high on its 1024
// atlas, and the drift filled them at the first stages. Measured within GLASS_PROBE each way.
const float GLASS_SPAN_FULL = 0.05;
const float GLASS_SPAN_MIN = 0.25;
const float GLASS_PROBE = 0.03;
const float GLASS_EDGE_FREQ = 60.0;
const float GLASS_SILL = 1.8;
const float GLASS_FLAT = 0.9;
// Body snow fields: a layer with thickness. RELIEF_PX: screen pixels between the two samples of
// the field's height (thickness plus lumps), whose difference shades it as if lit from the top of
// the screen: the edge facing up bright, the one facing down in a blue-grey shade.
const float RELIEF_PX = 2.0;
const float RELIEF_GAIN = 5.0;
// Snow stuck on the upper sides, so that it does not stop dead at the edge of the roof: up to
// SIDE_SNOW of the gain a flat top gets, from SIDE_LOW to SIDE_HIGH world units above the model's
// origin (the middle of the body; roofs are about 0.6..0.7 above it). Bevels count as flat from
// minFacing + BEVEL up.
const float SIDE_SNOW = 0.55;
const float SIDE_LOW = 0.25;
const float SIDE_HIGH = 0.7;
const float BEVEL = 0.35;
const vec3 SNOW_SHADE = vec3(0.70, 0.76, 0.86);
// Body icing, mixed into the paint: soft frost patches (FILM_ALPHA where thin, crusted snow in
// their cores), a thin hoarfrost haze (HAZE at full snow) in large zones (ICE_ZONE_FREQ, UV) that
// grow with the snow, clean paint between them; crystal grain in both.
const float FILM_ALPHA = 0.55;
const float HAZE = 0.4;
const float ICE_ZONE_FREQ = 8.0;
const vec3 ICE_TINT = vec3(0.80, 0.86, 0.95);
// Glass: patchy frost film over it, up to GLASS_FROST at full snow
const float GLASS_FROST = 0.35;
// Hoarfrost on the glass (GLASS_LAYER), UV units (a windscreen is about 0.2 of the atlas): it grows
// in from the edge (within GLASS_RIM_NEAR / GLASS_RIM_FAR, ragged by noise) as a frosted haze with
// needles of ice in three directions 60 degrees apart, as ice crystals grow (NEEDLE_ALONG long,
// NEEDLE_ACROSS thin, NEEDLE_DENSITY how many); opacity from GLASS_THIN at the first stage to
// GLASS_THICK at the last (frosted over: shapes behind it hardly show).
const float GLASS_RIM_NEAR = 0.012;
const float GLASS_RIM_FAR = 0.03;
const float NEEDLE_ALONG = 30.0;
const float NEEDLE_ACROSS = 380.0;
const float NEEDLE_DENSITY = 0.8;
const float GLASS_THIN = 0.5;
const float GLASS_THICK = 0.9;
// Wheels: tyre where the wheel's texture, averaged over TYRE_BLUR world units (so small dark holes
// and shading on the rim do not count), is darker than TYRE_LUMA; the tyre's sides count at least
// TYRE_FACING as facing up, so they get patches. Nothing on a wheel is finer than about 3 pixels
// (about 150 px per world unit at the default zoom): single pixels flicker as the wheel turns, so
// no crumbs and no rim band, and the grain of the ragged patch edges (WHEEL_GRAIN_FREQ) is coarse;
// smooth edges and a flat colour looked like liquid, hence the fringe, the mottling and the greyer
// thin edges (WHEEL_EDGE_SHADE). The rim gets the densest parts of the patches (RIM_BASE).
// Frequencies per world unit, tuned offline (numpy port and the real shaders rendered with
// moderngl, vanilla and a KI5 wheel) to the coverage the UV version had on KI5 wheels.
const float TYRE_LUMA = 0.33;
const float TYRE_BLUR = 0.015;
const float TYRE_FACING = 0.3;
const float WHEEL_NOISE_FREQ = 20.0;
const float WHEEL_COVER_FREQ = 10.0;
const float WHEEL_COVER_BASE = 0.70;
const float WHEEL_PATCH_FREQ = 14.0;
const float WHEEL_PATCH_BASE = 0.73;
const float RIM_BASE = 0.85;
const float WHEEL_GRAIN_FREQ = 45.0;
const float WHEEL_FRINGE = 0.1;
const float WHEEL_MOTTLE_FREQ = 30.0;
const float WHEEL_EDGE_SHADE = 0.8;
// World up in the frame of vertViewNormal. Core.DoPushIsoStuff: projection ortho(-w/2, w/2, -h/2,
// h/2, -10, 10) (y kept, z negated), view rotated 30 degrees about X after 135 about Y, world up +Y
// before that, so up = (0, cos 30, sin 30) with z negated.
const vec3 UP_VIEW = vec3(0.0, 0.8660254, -0.5);

// The game's 3D vehicle preview (UI3DScene: the debug Vehicle Editor, mods' admin panels) draws every
// model of a vehicle script, the shells too, and binds a model's own texture where the world binds
// the vehicle's: Texture0 for a vehicle shader (the world: the vehicle's paint), Texture for a wheel
// (the preview draws only a wheel part's first model: the shells' PREVIEW stand-in). Those own
// textures are the preview mark (tools/gen_vehicle_snow.py: white, alpha 7/255, also when the loader
// premultiplies the alpha), which no vehicle or wheel texture has, so the preview shows no snow.
bool previewMark(vec4 t)
{
	return t.a > 5.5 / 255.0 && t.a < 8.5 / 255.0 && abs(t.r - t.g) < 2.0 / 255.0 && abs(t.g - t.b) < 2.0 / 255.0
		&& (t.r > 0.9 || abs(t.r - t.a) < 2.0 / 255.0);
}

float hash(vec2 p)
{
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float valueNoise(vec2 p)
{
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	float a = hash(i);
	float b = hash(i + vec2(1.0, 0.0));
	float c = hash(i + vec2(0.0, 1.0));
	float d = hash(i + vec2(1.0, 1.0));
	return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

// 4 octaves of value noise, 0..1 around 0.5: organic patch shapes with ragged edges
float fbm(vec2 p)
{
	return valueNoise(p) * 0.5 + valueNoise(p * 2.03) * 0.25 + valueNoise(p * 4.01) * 0.125
		+ valueNoise(p * 8.07) * 0.125;
}

#ifdef WHEEL
float hash3(vec3 p)
{
	return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453);
}

float valueNoise3(vec3 p)
{
	vec3 i = floor(p);
	vec3 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);
	float x0 = mix(hash3(i), hash3(i + vec3(1.0, 0.0, 0.0)), f.x);
	float x1 = mix(hash3(i + vec3(0.0, 1.0, 0.0)), hash3(i + vec3(1.0, 1.0, 0.0)), f.x);
	float x2 = mix(hash3(i + vec3(0.0, 0.0, 1.0)), hash3(i + vec3(1.0, 0.0, 1.0)), f.x);
	float x3 = mix(hash3(i + vec3(0.0, 1.0, 1.0)), hash3(i + vec3(1.0, 1.0, 1.0)), f.x);
	return mix(mix(x0, x1, f.y), mix(x2, x3, f.y), f.z);
}

// 3 octaves, 0..1 around 0.5: lumpy patches without pixel-sized detail
float fbm3(vec3 p)
{
	return (valueNoise3(p) * 0.5 + valueNoise3(p * 2.03) * 0.25 + valueNoise3(p * 4.01) * 0.125) / 0.875;
}

// Snow colour of a wheel patch: mottled, greyer where it thins out towards its edge (d near 0)
vec3 wheelSnow(vec3 base, float d, float mottle)
{
	return base * (0.88 + 0.12 * mottle) * mix(WHEEL_EDGE_SHADE, 1.0, smoothstep(0.0, 0.12, d));
}
#endif

// Solid where d >= 0.04, grainy along a ragged fringe below that (width w)
bool raggedFill(float d, float w, float grain)
{
	return d >= 0.04 || (d >= 0.04 - w && grain <= (d - 0.04 + w) / w);
}

#ifdef VEHICLE_MASK
// Window zones of the vehicle mask, colZone7..12 in vanilla vehicle_common.frag.h
// (RH, RT, LH, LT side windows, T rear window, H windshield).
bool isBare(vec2 uv)
{
#ifdef NO_MASK
	return false;
#else
	vec3 m = texture2D(TextureMask, uv).rgb;
	return length(m - vec3(0.0, 0.5, 0.5)) < 0.1 || length(m - vec3(0.5, 0.5, 0.0)) < 0.1
		|| length(m - vec3(0.5, 0.0, 0.5)) < 0.1 || length(m - vec3(0.0, 0.0, 0.5)) < 0.1
		|| length(m - vec3(0.5, 0.0, 0.0)) < 0.1 || length(m - vec3(0.0, 0.5, 0.0)) < 0.1;
#endif
}

// Whether a bare point (glass) lies within r of a snow-carrying point (8 directions).
bool nearEdge(vec2 uv, float r)
{
	float d = r * 0.7071;
	return !isBare(uv + vec2(r, 0.0)) || !isBare(uv - vec2(r, 0.0))
		|| !isBare(uv + vec2(0.0, r)) || !isBare(uv - vec2(0.0, r))
		|| !isBare(uv + vec2(d, d)) || !isBare(uv - vec2(d, d))
		|| !isBare(uv + vec2(d, -d)) || !isBare(uv - vec2(d, -d));
}

// Distance from a bare point to the nearest snow-carrying one, as a fraction of r: 1 when none
// lies within r, else to 1/16 of r (binary search: nearEdge only grows with the radius).
float edgeDist(vec2 uv, float r)
{
	if (!nearEdge(uv, r)) return 1.0;
	float lo = 0.0;
	float hi = 1.0;
	for (int i = 0; i < 3; i++)
	{
		float m = (lo + hi) * 0.5;
		if (nearEdge(uv, r * m)) hi = m;
		else lo = m;
	}
	return (lo + hi) * 0.5;
}

// The same straight along dir (a unit UV direction), to 1/24 of r: the first of 6 steps that leaves
// the glass, then halved twice
float rayDist(vec2 uv, vec2 dir, float r)
{
	float hi = 0.0;
	for (int k = 1; k <= 6; k++)
	{
		if (hi == 0.0 && !isBare(uv + dir * (r * float(k) / 6.0))) hi = float(k) / 6.0;
	}
	if (hi == 0.0) return 1.0;
	float lo = hi - 1.0 / 6.0;
	for (int i = 0; i < 2; i++)
	{
		float m = (lo + hi) * 0.5;
		if (isBare(uv + dir * (r * m))) lo = m;
		else hi = m;
	}
	return (lo + hi) * 0.5;
}

// How much of the drift and rim glass at uv gets for its size (GLASS_SPAN_FULL): its height through
// uv along dir (a unit UV direction, down the glass), frame to frame.
float glassScale(vec2 uv, vec2 dir)
{
	float span = (rayDist(uv, dir, GLASS_PROBE) + rayDist(uv, -dir, GLASS_PROBE)) * GLASS_PROBE;
	return clamp(span / GLASS_SPAN_FULL, GLASS_SPAN_MIN, 1.0);
}

// Down the glass in UV units (unit length): against uphill (the height's gradient in UV), else
// screen down (pixUp: one screen pixel up in UV).
vec2 glassDown(vec2 pixUp, vec2 uphill, float det)
{
	if (det != 0.0 && dot(uphill, uphill) > 0.0) return -normalize(uphill);
	if (dot(pixUp, pixUp) > 0.0) return -normalize(pixUp);
	return vec2(0.0, 1.0);
}

float zone(vec3 m, vec3 c)
{
	return 1.0 - step(0.01, length(m - c));
}

// Whether the mask colour m is the zone of a part the vehicle has not got (TextureUninstall):
// vanilla vehicle.frag paints it grey there, and there is no glass to carry frost or snow. The zone
// colours and the test are vanilla's (colZone1..27), so it is the same pixels.
bool uninstalled(vec3 m)
{
	mat4 a = mat4(0.0);
	mat4 b = mat4(0.0);
	a[0] = vec4(zone(m, vec3(1.0, 0.0, 0.0)), zone(m, vec3(0.0, 1.0, 0.0)), zone(m, vec3(0.0, 1.0, 1.0)), zone(m, vec3(1.0, 1.0, 0.0)));
	a[1] = vec4(zone(m, vec3(1.0, 0.0, 1.0)), zone(m, vec3(0.0, 0.0, 1.0)), zone(m, vec3(0.0, 0.5, 0.5)), zone(m, vec3(0.5, 0.5, 0.0)));
	a[2] = vec4(zone(m, vec3(0.5, 0.0, 0.5)), zone(m, vec3(0.0, 0.0, 0.5)), zone(m, vec3(0.5, 0.0, 0.0)), zone(m, vec3(0.0, 0.5, 0.0)));
	a[3] = vec4(zone(m, vec3(0.75, 0.0, 0.75)), zone(m, vec3(0.0, 0.0, 0.75)), zone(m, vec3(0.0, 0.75, 0.75)), zone(m, vec3(0.75, 0.75, 0.0)));
	b[0] = vec4(zone(m, vec3(0.0)), zone(m, vec3(0.25, 0.0, 0.0)), zone(m, vec3(0.75, 0.0, 0.0)), zone(m, vec3(0.0, 0.75, 0.0)));
	b[1] = vec4(zone(m, vec3(0.0, 0.25, 0.0)), zone(m, vec3(0.5, 0.25, 0.0)), zone(m, vec3(0.5, 0.75, 0.0)), zone(m, vec3(0.75)));
	b[2] = vec4(zone(m, vec3(0.25)), zone(m, vec3(1.0, 0.0, 0.5)), zone(m, vec3(0.0, 1.0, 0.5)), 0.0);
	float t = dot(a[0], TextureUninstall1[0]) + dot(a[1], TextureUninstall1[1]) + dot(a[2], TextureUninstall1[2])
		+ dot(a[3], TextureUninstall1[3]) + dot(b[0], TextureUninstall2[0]) + dot(b[1], TextureUninstall2[1])
		+ dot(b[2], TextureUninstall2[2]);
	return t >= 0.5;
}

// Keeps TextureRust in the program (see VEHICLE_MASK above): the engine sets TextureRustA to 0..1,
// so this never changes col, but the compiler cannot tell.
vec3 keepVehicleShader(vec3 col, vec2 uv)
{
	if (TextureRustA < -1.0) return texture2D(TextureRust, uv).rgb;
	return col;
}

// Signed distance-like value of the snow fields on top: >= 0 inside a field, the more the thicker
float fieldDist(vec2 uv, float up, float amount)
{
	float noise = valueNoise(uv * 40.0) * 0.65 + valueNoise(uv * 110.0) * 0.35;
	return fbm(uv * COVER_FREQ + vec2(5.3, 1.7)) + amount * COVER_GAIN * up + (noise - 0.5) * 0.08 - COVER_BASE;
}

// Height of the snow layer at a field value d: its thickness, lumpy inside
float fieldHeight(vec2 uv, float d)
{
	float lump = valueNoise(uv * 24.0 + vec2(3.1, 8.2));
	return smoothstep(-0.04, 0.16, d) * (0.97 + 0.06 * lump);
}

// How far the drift on the glass reaches at uv, 0.. about 1.2: ragged, lumpy
float glassRag(vec2 uv)
{
	return fbm(uv * GLASS_EDGE_FREQ + vec2(4.7, 0.9)) * 0.8 + valueNoise(uv * 110.0) * 0.4;
}

// The drift on the frame of the glass at uv (bare), in the fields' units (>= 0 in it, the more the
// thicker): r wide (UV) all round, ragged, and GLASS_SILL times that along the bottom edge (the
// frame straight down the glass, down a unit UV direction) where slide (0..1) says the snow slides;
// k: the glass's glassScale (r has it already; the result is in the units of full-size glass)
float glassDrift(vec2 uv, float r, float slide, vec2 down, float k)
{
	float rag = glassRag(uv);
	float d = (0.3 + rag) * r - edgeDist(uv, 1.5 * r) * 1.5 * r;
	if (slide > 0.0)
	{
		float rs = r * GLASS_SILL;
		d = max(d, (0.2 + rag) * rs * slide - rayDist(uv, down, 1.3 * rs) * 1.3 * rs);
	}
	return d * 0.6 / (GLASS_EDGE * k);
}
#else
// Wheels: not the tyre (rim, hub), from the wheel's own texture averaged over r (UV units)
bool isBare(vec2 uv, float r)
{
	vec3 c = texture2D(Texture, uv).rgb + texture2D(Texture, uv + vec2(r, 0.0)).rgb
		+ texture2D(Texture, uv - vec2(r, 0.0)).rgb + texture2D(Texture, uv + vec2(0.0, r)).rgb
		+ texture2D(Texture, uv - vec2(0.0, r)).rgb;
	return dot(c, vec3(0.299, 0.587, 0.114)) >= TYRE_LUMA * 5.0;
}
#endif

vec3 upAxis(float sel)
{
	if (sel < 0.125) return vec3(0.0, 1.0, 0.0);
	if (sel < 0.375) return vec3(0.0, 0.0, 1.0);
	if (sel < 0.625) return vec3(0.0, 0.0, -1.0);
	if (sel < 0.875) return vec3(0.0, -1.0, 0.0);
	return vec3(1.0, 0.0, 0.0);
}

float lightTerm(vec3 normal, vec3 dir)
{
	float d = max(dot(normal, normalize(dir)), 0.0);
	return ceil(d * 3.0) / 3.0; // quantise(d, 3.0) from util/math.glsl, as the vehicle shaders do
}

void main()
{
	// the whole model or nothing (one texel colour), so no derivative below misses a pixel
#ifdef VEHICLE_MASK
	if (previewMark(texture2D(Texture0, texCoords))) discard;
#else
	if (previewMark(texture2D(Texture, texCoords))) discard;
#endif
	// before any discard: derivatives need every pixel of the 2x2 quad
	float slope = min(fwidth(gl_FragCoord.z) * SLOPE_BIAS, BIAS_SCALE * SLOPE_CAP);
	vec3 normal = normalize(vertNormal);
	bool debugView = P_AMOUNT > 0.99;
	float amount = clamp(P_AMOUNT / 0.98, 0.0, 1.0);
	// snow colour col (unlit) with opacity cover over the vehicle as drawn
	vec3 col;
	float cover = 1.0;
#ifdef WHEEL
	// UV units per world unit here (both are linear across a triangle), for the tyre test
	float uvPerUnit = (length(dFdx(texCoords)) + length(dFdy(texCoords)))
		/ max(length(dFdx(vertMeshPos)) + length(dFdy(vertMeshPos)), 1e-6);
	bool bare = isBare(texCoords, TYRE_BLUR * uvPerUnit);
	// wheels share a mesh: P_SEED shifts the noise per wheel
	vec3 wp = vertMeshPos + P_SEED * vec3(3.713, 1.971, 2.867);
	float noise = valueNoise3(wp * WHEEL_NOISE_FREQ);
	float grain = valueNoise3(wp * WHEEL_GRAIN_FREQ + vec3(1.3, 7.7, 4.1));
	float mottle = valueNoise3(wp * WHEEL_MOTTLE_FREQ + vec3(9.1, 2.3, 5.9));
	float facing = P_AXIS < 0.0 ? dot(normalize(vertViewNormal), UP_VIEW) : dot(normal, upAxis(P_AXIS));
	facing = max(facing, TYRE_FACING);
	float minFacing = mix(0.9, 0.35, amount);
	if (debugView)
	{
		col = bare ? vec3(1.0, 0.0, 0.0) : (P_AXIS < 0.0 ? normalize(vertViewNormal) : normal) * 0.5 + 0.5;
	}
	else
	{
#ifdef SNOW_LAYER
		// the settled snow: fields on the tyre's top
		float up = smoothstep(minFacing - 0.25, 1.0, facing);
		float dc = fbm3(wp * WHEEL_COVER_FREQ + vec3(5.3, 1.7, 3.1)) + amount * COVER_GAIN * up
			+ (noise - 0.5) * 0.08 - WHEEL_COVER_BASE;
		if (!bare && up > 0.0 && raggedFill(dc, WHEEL_FRINGE, grain))
		{
			col = wheelSnow(SNOW_COLOUR, dc, mottle);
		}
		else
#endif
		{
#ifdef ICE_LAYER
			// stuck-on patches on the tyre, and the densest of them on the rim
			float frost = amount * amount * SIDE_FROST * smoothstep(-0.4, minFacing, facing);
			float d = fbm3(wp * WHEEL_PATCH_FREQ) + frost * 0.18 - (bare ? RIM_BASE : WHEEL_PATCH_BASE);
			if (!raggedFill(d, WHEEL_FRINGE, grain)) discard;
			col = wheelSnow(FROST_COLOUR, d, mottle);
#else
			discard;
#endif
		}
	}
#else
	// a broken, removed or open window (or a removed door painted on the body): vanilla's grey shows
#ifndef NO_MASK
	if (uninstalled(texture2D(TextureMask, texCoords).rgb)) discard;
#endif
	bool bare = isBare(texCoords);
	vec2 nuv = texCoords;
	// one screen pixel up in UV units (constant over a triangle: the projection is orthographic)
	vec2 pixUp = dFdy(texCoords);
	// downhill on the surface in UV units (the gradient of the height in UV, from the screen-space
	// derivatives of both), for the snow sliding down the glass
	vec2 pixRight = dFdx(texCoords);
	vec2 dh = vec2(dFdx(vertHeight), dFdy(vertHeight));
	float det = pixRight.x * pixUp.y - pixRight.y * pixUp.x;
	vec2 uphill = vec2(pixUp.y * dh.x - pixRight.y * dh.y, pixRight.x * dh.y - pixUp.x * dh.x) * sign(det);
	float noise = valueNoise(nuv * 40.0) * 0.65 + valueNoise(nuv * 110.0) * 0.35;
	float grain = valueNoise(nuv * 420.0);
	// ice crystals: fine grain in the frost's opacity
	float cryst = valueNoise(nuv * 260.0) * 0.6 + valueNoise(nuv * 610.0) * 0.4;
	float facing = P_AXIS < 0.0 ? dot(normalize(vertViewNormal), UP_VIEW) : dot(normal, upAxis(P_AXIS));
	// the steeper, the more snow it takes to settle
	float minFacing = mix(0.9, 0.35, amount);
	float frost = amount * amount * SIDE_FROST * smoothstep(-0.4, minFacing, facing);
	if (debugView)
	{
		// mesh normal, or with P_AXIS below 0 the camera-frame one (up shows as UP_VIEW * 0.5 + 0.5)
		col = bare ? vec3(1.0, 0.0, 0.0) : (P_AXIS < 0.0 ? normalize(vertViewNormal) : normal) * 0.5 + 0.5;
	}
#ifdef GLASS_LAYER
	else
	{
		if (!bare) discard;
		// needles of ice in three directions 60 degrees apart
		float needle = 0.0;
		for (int k = 0; k < 3; k++)
		{
			float ang = float(k) * 1.0472 + 0.35;
			vec2 dir = vec2(cos(ang), sin(ang));
			vec2 q = vec2(dot(nuv, dir) * NEEDLE_ALONG, dot(nuv, vec2(-dir.y, dir.x)) * NEEDLE_ACROSS) + float(k) * 17.3;
			needle = max(needle, smoothstep(NEEDLE_DENSITY, 0.97, valueNoise(q)));
		}
		// grows in from the edge, the edge of the frost ragged
		float rag = (0.6 + 0.8 * noise) * glassScale(texCoords, glassDown(pixUp, uphill, det));
		float rim = nearEdge(texCoords, GLASS_RIM_NEAR * rag) ? 0.35 : (nearEdge(texCoords, GLASS_RIM_FAR * rag) ? 0.17 : 0.0);
		float field = fbm(nuv * 14.0 + vec2(1.7, 4.3)) + rim + needle * 0.1;
		// the first stage: the edges and a few patches; the last: all over
		float th = 1.02 - amount * 0.8;
		float grown = smoothstep(th - 0.08, th + 0.04, field);
		// haze where it has grown; the needles brighter in it and reaching a little past its edge
		float a = max(grown * mix(GLASS_THIN, GLASS_THICK, amount) * (0.75 + 0.25 * cryst),
			needle * smoothstep(th - 0.15, th, field) * 0.95);
		if (a < 0.04) discard;
		col = mix(ICE_TINT, SNOW_COLOUR, 0.35 + 0.65 * max(needle, cryst * 0.5));
		cover = min(a, 1.0);
	}
#else
	else if (bare)
	{
#if !defined(ICE_LAYER) || defined(CLEAN_GLASS)
		discard;
#endif
		// glass: never covered; a drift of snow on its frame that widens with the snow (more along
		// the bottom edge), and a thin frost film in zones that lets the glass show through
		// sliding down: on tilted glass, along the bottom edge
		float slide = 1.0 - smoothstep(0.6, GLASS_FLAT, facing);
		vec2 down = vec2(0.0);
		if (det != 0.0 && dot(uphill, uphill) > 0.0) down = -normalize(uphill);
		else slide = 0.0;
		float k = glassScale(texCoords, glassDown(pixUp, uphill, det));
		float r = GLASS_EDGE * sqrt(amount) * k;
		float d = glassDrift(texCoords, r, slide, down, k);
		col = vec3(0.0);
		cover = 0.0;
		if (raggedFill(d, 0.08, grain))
		{
			// as the fields: lit from the top of the screen, here by its lumps one pixel apart (the
			// distance to the frame comes in steps of the mask's pixels, its relief showed them), and
			// in shade where it thins out
			vec2 upUv = nuv + pixUp * RELIEF_PX;
			float relief = (glassRag(nuv) - glassRag(upUv)) * r * (0.6 / (GLASS_EDGE * k)) * RELIEF_GAIN;
			float shade = clamp(0.8 + relief + 0.12 * smoothstep(0.0, 0.25, d), 0.0, 1.0);
			col = mix(SNOW_SHADE, SNOW_COLOUR, shade) * (0.96 + 0.04 * cryst);
			cover = mix(0.7, 1.0, smoothstep(-0.04, 0.06, d));
		}
		else
		{
			float film = smoothstep(0.5 - amount * 0.1, 0.6 - amount * 0.1, fbm(nuv * ICE_ZONE_FREQ + vec2(2.9, 6.1)));
			cover = amount * GLASS_FROST * film * (0.55 + 0.45 * cryst);
			if (cover < 0.04) discard;
			col = mix(ICE_TINT, SNOW_COLOUR, cryst);
		}
	}
	else
	{
#ifdef SNOW_LAYER
		// ragged fields of settled snow on what faces up, larger and more of them with more snow; a
		// layer with thickness, lumps and a powdery fringe, not a flat white
		float up = smoothstep(minFacing - 0.25, min(minFacing + BEVEL, 1.0), facing);
		up = max(up, SIDE_SNOW * smoothstep(-0.3, 0.15, facing) * smoothstep(SIDE_LOW, SIDE_HIGH, vertHeight));
		float dc = fieldDist(nuv, up, amount);
		if (up > 0.0 && raggedFill(dc, 0.08, grain))
		{
			vec2 upUv = nuv + pixUp * RELIEF_PX;
			float relief = (fieldHeight(nuv, dc) - fieldHeight(upUv, fieldDist(upUv, up, amount))) * RELIEF_GAIN;
			// relief only shades: lit above SNOW_COLOUR it outshone the ground's snow
			float shade = clamp(0.86 + relief, 0.0, 1.0);
			vec3 snow = mix(SNOW_SHADE, SNOW_COLOUR, shade);
			// thin at the grainy fringe: the paint shows through
			col = snow * (0.96 + 0.04 * cryst);
			cover = mix(0.7, 1.0, smoothstep(-0.04, 0.06, dc));
		}
		else
#endif
		{
#ifdef ICE_LAYER
			// elsewhere (and under the fields) icing: soft frost patches that thicken into crusted
			// snow in their cores, more towards the top, and a thin hoarfrost haze over the rest
			float pd = fbm(nuv * 30.0) + frost * 0.18 - 0.78;
			float crust = smoothstep(0.02, 0.12, pd);
			// the patch is loose crystals where it is thin
			float spot = smoothstep(-0.08, 0.03, pd);
			float a = spot * mix(smoothstep(0.15, 0.75, cryst), 1.0, crust) * mix(FILM_ALPHA, 0.95, crust);
			float zone = smoothstep(0.6 - frost * 0.12, 0.68 - frost * 0.12, fbm(nuv * ICE_ZONE_FREQ + vec2(7.3, 2.9)));
			a = max(a, frost * HAZE * zone * smoothstep(-0.5, 0.3, facing) * smoothstep(0.2, 0.8, cryst));
			if (facing < -0.5 || a < 0.04) discard;
			col = mix(ICE_TINT, FROST_COLOUR, crust) * (0.94 + 0.06 * grain);
			cover = min(a, 1.0);
#else
			discard;
#endif
		}
	}
#endif
#endif

	vec3 lighting = AmbientColour;
	lighting += Light0Colour * lightTerm(normal, Light0Direction);
	lighting += Light1Colour * lightTerm(normal, Light1Direction);
	lighting += Light2Colour * lightTerm(normal, Light2Direction);
	lighting += Light3Colour * lightTerm(normal, Light3Direction);
	lighting += Light4Colour * lightTerm(normal, Light4Direction);
	lighting = clamp(lighting, 0.0, 1.0);

	// snow takes less of the light's colour than paint (the vehicle shaders desaturate TintColour by
	// 0.3; under an orange street lamp it went beige)
	float grey = dot(TintColour, vec3(0.2126, 0.7152, 0.0722));
	vec3 snowTint = mix(TintColour, vec3(grey), SNOW_DESATURATE);

	// the snow is lit as the ground under the vehicle (AmbientColour is its square's light): the
	// engine adds the square's lamps once more as model lights, which white snow showed as a glow
	// in the dark where the paint stays dark
	vec3 snowLight = min(lighting, AmbientColour);
#ifdef SNOW_DARK
	if (!debugView) col *= DARK_RGB;
#endif
	if (!debugView) col *= snowLight * snowTint;

#ifdef VEHICLE_MASK
	// DrawVehicle does not set Alpha for vehicle shaders, the vehicle's alpha comes as the paint's:
	// the snow fades with the body (out of sight, and for its driver), else the seats' snow showed
	// through a fading body
	gl_FragColor = vec4(keepVehicleShader(col, texCoords), cover * TexturePainColor.a);
#else
	gl_FragColor = vec4(col, cover * Alpha);
#endif
	gl_FragDepth = gl_FragCoord.z - (P_BIAS - 0.5) * 2.0 * (BIAS_SCALE + slope);
}
