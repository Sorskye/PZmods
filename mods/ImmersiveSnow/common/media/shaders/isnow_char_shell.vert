#version 330
// generated by tools/gen_char_snow.py, do not edit
#define INFLATE 0.001500
// Immersive Snow: skinned snow model, a copy of vanilla basicEffect.vert plus inflation along the
// normal and the camera-frame normal.

layout (location = 0) in vec4 vertex;
layout (location = 1) in vec4 normal;
layout (location = 2) in vec4 boneWeights;
layout (location = 3) in vec4 boneIndices;
layout (location = 4) in vec2 uv;

out vec3 vertColour;
out vec3 vertNormal;
out vec3 vertViewNormal;
out float vertUpFacing;
out float vertRestUp;
out float vertRestHeight;
out vec3 vertRestPos;
out vec2 texCoords;

uniform mat4 ModelViewProjection;
uniform float targetDepth = 0.5;
uniform mat4 MatrixPalette[60];
uniform vec2 UVScale = vec2(1,1);
uniform float HighResDepthMultiplier = 0.0;
uniform float FinalScale = 1.0;

// World up in the camera frame, as in isnow_vehiclesnow.frag.
const vec3 UP_VIEW = vec3(0.0, 0.8660254, -0.5);

// Normal n in the camera's rotation frame (see isnow_vehiclesnow.frag, UP_VIEW): the normalised
// rows of the upper 3x3 of the model-view-projection are the rotation's rows.
vec3 viewNormal(mat3 m, vec3 n)
{
	vec3 r0 = vec3(m[0][0], m[1][0], m[2][0]);
	vec3 r1 = vec3(m[0][1], m[1][1], m[2][1]);
	vec3 r2 = vec3(m[0][2], m[1][2], m[2][2]);
	return vec3(dot(r0, n) / length(r0), dot(r1, n) / length(r1), dot(r2, n) / length(r2));
}

void main()
{
	vec4 position = vec4(vertex.xyz, 1.0);
	vec4 n = vec4(normal.xyz, 0.0);

	texCoords = uv * UVScale.xy;

	mat4 boneEffect = mat4(0.0);
	if(boneWeights.x > 0.0)
		boneEffect += MatrixPalette[int(boneIndices.x)] * boneWeights.x;
	if(boneWeights.y > 0.0)
		boneEffect += MatrixPalette[int(boneIndices.y)] * boneWeights.y;
	if(boneWeights.z > 0.0)
		boneEffect += MatrixPalette[int(boneIndices.z)] * boneWeights.z;
	if(boneWeights.w > 0.0)
		boneEffect += MatrixPalette[int(boneIndices.w)] * boneWeights.w;

	n = boneEffect * n;
	vertNormal = n.xyz;
	vertViewNormal = viewNormal(mat3(ModelViewProjection), n.xyz);
	vertUpFacing = dot(normalize(vertViewNormal), UP_VIEW);
	vertColour = vec3(1.0);

	// Mesh units: the palette maps the mesh into the character's model space (metres, the body
	// ~0.98 tall). Vanilla meshes are in metres already, but a modded mesh exported with its object
	// scale left in the bind pose (Alice's Weapon Sling: scale 100, vertices in 1/100 m) gets that
	// scale from the palette, so its mesh units say nothing about the body.
	float meshScale = (length(boneEffect[0].xyz) + length(boneEffect[1].xyz) + length(boneEffect[2].xyz)) / 3.0;
	if (meshScale > 0.5 && meshScale < 2.0)
	{
		// rest pose (character meshes: +Y up, feet 0, head ~0.98): how much the surface faces up and
		// its height there; they do not change with the animation, so what they decide stays on the cloth
		vertRestUp = normalize(normal.xyz).y;
		vertRestHeight = vertex.y;
		vertRestPos = vertex.xyz;
	}
	else
	{
		// other units (and axes): no rest pose to go by, the mesh counts as upper body and faces as it
		// does now (as the static shells); the noise keeps its size in metres
		vertRestUp = vertUpFacing;
		vertRestHeight = 1.0;
		vertRestPos = vertex.xyz * meshScale;
	}

	vec4 positionScaled = boneEffect * position;
	// inflated after skinning, in model space: INFLATE is metres whatever the mesh units (before
	// skinning it was multiplied by the mesh scale, a ring of snow 15 cm off the sling)
	float nl = length(n.xyz);
	if (nl > 0.0)
		positionScaled.xyz += n.xyz / nl * INFLATE;
	positionScaled.xyz *= FinalScale;
	vec4 o = ModelViewProjection * positionScaled;

	vec4 origin = ModelViewProjection * vec4(0, 0, 0, 1);
	o.z += (origin.z - o.z) * HighResDepthMultiplier;
	float clip = ((o.z+1.0) / 2.0); // -1,+1 -> 0,2 -> 0,1
	clip += targetDepth - 0.5;
	o.z = (clip*2)-1; // 0-1 -> 0-2 -> -1,+1
	gl_Position = o;
}
